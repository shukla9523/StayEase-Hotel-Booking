# StayEase Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Leave blank to automatically use the embedded zero-config MongoDB instance,
# or set to your local or MongoDB Atlas connection string:
# MONGO_URI=mongodb://localhost:27017/stayease
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/stayease?retryWrites=true&w=majority
MONGO_URI=

# JWT Secrets
JWT_SECRET=stayease_super_secure_jwt_secret_key_2026_dev_env
JWT_EXPIRES_IN=7d

# Stripe Test Credentials (Optional - if blank, StayEase switches to interactive Demo Gateway)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (Optional - high-res Unsplash CDN fallback is active by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
